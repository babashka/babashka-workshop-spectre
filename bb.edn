{:paths ["src" "test"]
 :deps {de.timokramer/charm.clj {:mvn/version "0.2.73"}}
 :tasks
 {test {:doc "Run tests. `bb test :nses spectre.cli-test` runs one exercise"
        :extra-paths ["test"]
        :extra-deps {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
        :exec-fn cognitect.test-runner.api/test
        :exec-args {:dirs ["test"]}
        :cli {:coerce {:dirs [:string]
                       :nses [:symbol]
                       :patterns [:string]
                       :vars [:symbol]
                       :includes [:keyword]
                       :excludes [:keyword]}}}
  pw {:exec-fn spectre.cli/generate}
  tui {:doc "Browse and edit sites in db.edn"
       :exec-fn spectre.tui/browse}
  tui2 {:doc "Same as tui, built on charm.clj"
        :exec-fn spectre.tui2/browse}}}
